{
    "name": "amdadulhaq/database-backup-laravel",
    "description": "Simple database backups for Laravel (PostgreSQL, MySQL, MariaDB, SQLite) streamed to any filesystem disk, including S3-compatible APIs like Cloudflare R2.",
    "keywords": [
        "Amdadul Haq",
        "laravel",
        "database-backup-laravel",
        "backup",
        "database",
        "postgres",
        "mysql",
        "mariadb",
        "sqlite",
        "s3",
        "r2"
    ],
    "homepage": "https://github.com/amdad121/database-backup-laravel",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Amdadul Haq",
            "email": "amdadulhaq781@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-zlib": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0.3",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "AmdadulHaq\\DatabaseBackup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmdadulHaq\\DatabaseBackup\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmdadulHaq\\DatabaseBackup\\DatabaseBackupServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
